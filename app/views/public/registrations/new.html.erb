<div class="container-fluid py-4 px-5">
  <div class="row">
    <div class="col-xl-10">

      <h4 class="d-inline-block bg-light px-4 py-2 fw-bold mb-4">新規会員登録</h4>

      <!-- エラー -->
      <% if @customer.errors.any? %>
        <div class="row mb-3">
          <div class="col-lg-8">
            <div class="alert alert-danger py-2 mb-0">
              <p class="fw-bold mb-2"><%= @customer.errors.count %>件のエラーがあります。</p>
              <ul class="mb-0">
                <% @customer.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <%= form_with model: @customer, url: customer_registration_path, local: true do |f| %>

        <!-- 名前 -->
        <div class="row align-items-center mb-3">
          <div class="col-lg-3 fw-bold text-nowrap">名前</div>

          <div class="col-lg-4">
            <div class="input-group">
              <span class="input-group-text text-nowrap">(姓)</span>
              <%= f.text_field :last_name, class: "form-control" %>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="input-group">
              <span class="input-group-text text-nowrap">(名)</span>
              <%= f.text_field :first_name, class: "form-control" %>
            </div>
          </div>
        </div>

        <!-- フリガナ -->
        <div class="row align-items-center mb-3">
          <div class="col-lg-3 fw-bold text-nowrap">フリガナ</div>

          <div class="col-lg-4">
            <div class="input-group">
              <span class="input-group-text text-nowrap">(セイ)</span>
              <%= f.text_field :last_name_kana, class: "form-control" %>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="input-group">
              <span class="input-group-text text-nowrap">(メイ)</span>
              <%= f.text_field :first_name_kana, class: "form-control" %>
            </div>
          </div>
        </div>

        <!-- メール -->
        <div class="row align-items-center mb-3">
          <div class="col-lg-3 fw-bold text-nowrap">メールアドレス</div>
          <div class="col-lg-8">
            <%= f.email_field :email_address, class: "form-control", placeholder: "sample@example.com" %>
          </div>
        </div>

        <!-- 郵便番号 -->
        <div class="row align-items-center mb-3">
          <div class="col-lg-3 fw-bold text-nowrap">郵便番号(ハイフンなし)</div>
          <div class="col-lg-8">
            <%= f.text_field :postal_code, class: "form-control", placeholder: "0000000" %>
          </div>
        </div>

        <!-- 住所 -->
        <div class="row align-items-center mb-3">
          <div class="col-lg-3 fw-bold text-nowrap">住所</div>
          <div class="col-lg-8">
            <%= f.text_field :address, class: "form-control", placeholder: "東京都渋谷区代々木神園町0-0" %>
          </div>
        </div>

        <!-- 電話番号 -->
        <div class="row align-items-center mb-3">
          <div class="col-lg-3 fw-bold text-nowrap">電話番号(ハイフンなし)</div>
          <div class="col-lg-8">
            <%= f.text_field :telephone_number, class: "form-control", placeholder: "0000000000" %>
          </div>
        </div>

        <!-- パスワード -->
        <div class="row align-items-center mb-3">
          <div class="col-lg-3 fw-bold text-nowrap">パスワード(6文字以上)</div>
          <div class="col-lg-8">
            <%= f.password_field :password, class: "form-control" %>
          </div>
        </div>

        <!-- 確認 -->
        <div class="row align-items-center mb-4">
          <div class="col-lg-3 fw-bold text-nowrap">パスワード(確認用)</div>
          <div class="col-lg-8">
            <%= f.password_field :password_confirmation, class: "form-control" %>
          </div>
        </div>

        <!-- ボタン -->
        <div class="row mb-4">
          <div class="col-lg-3"></div>
          <div class="col-lg-8">
            <%= f.submit "新規登録", class: "btn btn-success px-4 py-2 fw-bold" %>
          </div>
        </div>

      <% end %>

      <!-- ログイン誘導 -->
      <div class="mt-3">
        <h5 class="d-inline-block bg-light px-4 py-2 fw-bold mb-2">既に登録済みの方</h5>
        <p class="ms-4 mb-0">
          <%= link_to "こちら", new_customer_session_path %> からログインしてください。
        </p>
      </div>

    </div>
  </div>
</div>
