<div class="registration-page py-4">
  <div class="container form-container">

    <!-- タイトル -->
    <h4 class="section-title mb-4">新規会員登録</h4>

    <!-- エラー -->
    <% if @customer.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @customer.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @customer, url: customer_registration_path, local: true do |f| %>

      <!-- 名前 -->
      <div class="row form-row">
        <div class="col-md-3 form-label-col">名前</div>

        <div class="col-md-1 text-end mini-label">(姓)</div>
        <div class="col-md-3">
          <%= f.text_field :last_name, class: "form-control" %>
        </div>

        <div class="col-md-1 text-end mini-label">(名)</div>
        <div class="col-md-3">
          <%= f.text_field :first_name, class: "form-control" %>
        </div>
      </div>

      <!-- フリガナ -->
      <div class="row form-row">
        <div class="col-md-3 form-label-col">フリガナ</div>

        <div class="col-md-1 text-end mini-label">(セイ)</div>
        <div class="col-md-3">
          <%= f.text_field :last_name_kana, class: "form-control" %>
        </div>

        <div class="col-md-1 text-end mini-label">(メイ)</div>
        <div class="col-md-3">
          <%= f.text_field :first_name_kana, class: "form-control" %>
        </div>
      </div>

      <!-- メール -->
      <div class="row form-row">
        <div class="col-md-3 form-label-col">メールアドレス</div>
        <div class="col-md-6">
          <%= f.email_field :email, class: "form-control", placeholder: "sample@example.com" %>
        </div>
      </div>

      <!-- 郵便番号 -->
      <div class="row form-row">
        <div class="col-md-3 form-label-col">郵便番号(ハイフンなし)</div>
        <div class="col-md-3">
          <%= f.text_field :postal_code, class: "form-control", placeholder: "0000000" %>
        </div>
      </div>

      <!-- 住所 -->
      <div class="row form-row">
        <div class="col-md-3 form-label-col">住所</div>
        <div class="col-md-8">
          <%= f.text_field :address, class: "form-control" %>
        </div>
      </div>

      <!-- 電話番号 -->
      <div class="row form-row">
        <div class="col-md-3 form-label-col">電話番号(ハイフンなし)</div>
        <div class="col-md-3">
          <%= f.text_field :telephone_number, class: "form-control", placeholder: "0000000000" %>
        </div>
      </div>

      <!-- パスワード -->
      <div class="row form-row">
        <div class="col-md-3 form-label-col">パスワード(6文字以上)</div>
        <div class="col-md-3">
          <%= f.password_field :password, class: "form-control" %>
        </div>
      </div>

      <!-- 確認 -->
      <div class="row form-row">
        <div class="col-md-3 form-label-col">パスワード(確認用)</div>
        <div class="col-md-3">
          <%= f.password_field :password_confirmation, class: "form-control" %>
        </div>
      </div>

      <!-- ボタン -->
      <div class="text-center mt-4">
        <%= f.submit "新規登録", class: "btn btn-success submit-btn" %>
      </div>

    <% end %>

    <!-- ログイン誘導 -->
    <div class="mt-5">
      <h5 class="section-title">既に登録済みの方</h5>
      <p class="mt-3">
        <%= link_to "こちら", new_customer_session_path %> からログインしてください。
      </p>
    </div>

  </div>
</div>
