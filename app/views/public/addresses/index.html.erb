<div class="container py-5">
  <div class="row">
    <div class="col-lg-10">

      <h4 class="d-inline-block bg-light px-4 py-2 fw-bold mb-5">配送先登録 / 一覧</h4>

      <% if @address.errors.any? %>
        <div class="alert alert-danger mb-4">
          <p class="fw-bold mb-2"><%= @address.errors.count %>件のエラーがあります。</p>
          <ul class="mb-0">
            <% @address.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @address, url: addresses_path, local: true do |f| %>
        <div class="row align-items-center mb-3">
          <div class="col-md-3">
            <label class="fw-bold mb-0">郵便番号(ハイフンなし)</label>
          </div>
          <div class="col-md-3">
            <%= f.text_field :postal_code,
                  class: "form-control",
                  placeholder: current_customer.postal_code %>
          </div>
        </div>

        <div class="row align-items-center mb-3">
          <div class="col-md-3">
            <label class="fw-bold mb-0">住所</label>
          </div>
          <div class="col-md-6">
            <%= f.text_field :address,
                  class: "form-control",
                  placeholder: current_customer.address %>
          </div>
        </div>

        <div class="row align-items-center mb-5">
          <div class="col-md-3">
            <label class="fw-bold mb-0">宛名</label>
          </div>
          <div class="col-md-3">
            <%= f.text_field :name,
                  class: "form-control",
                  placeholder: "#{current_customer.last_name}#{current_customer.first_name}" %>
          </div>

          <div class="col-md-3 offset-md-3 d-flex justify-content-end">
            <%= f.submit "新規登録", class: "btn btn-success fw-bold px-4" %>
          </div>
        </div>
      <% end %>

      <table class="table table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th style="width: 140px;">郵便番号</th>
            <th>住所</th>
            <th style="width: 180px;">宛名</th>
            <th style="width: 290px;"></th>
          </tr>
        </thead>
        <tbody>
          <% @addresses.each do |address| %>
            <tr>
              <td><%= address.postal_code %></td>
              <td><%= address.address %></td>
              <td><%= address.name %></td>
              <td class="text-center">
                <div class="d-flex justify-content-center gap-3">
                  <%= link_to "編集する",
                        edit_address_path(address),
                        class: "btn btn-success fw-bold px-4 py-2" %>

                  <%= link_to "削除する",
                        address_path(address),
                        data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                        class: "btn btn-danger fw-bold px-4 py-2" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

    </div>
  </div>
</div>
