<div class="container py-4">
  <div class="row">
    <div class="col-lg-10 mx-auto">

      <h2 class="d-inline-block px-4 py-1 mb-4 bg-light">注文情報入力</h2>

      <%= form_with model: @order,
                    url: confirm_orders_path,
                    method: :post,
                    data: { turbo: false } do |f| %>

        <!-- 支払い方法 -->
        <h4 class="fw-bold mb-3">支払方法</h4>
        <div class="ms-4 mb-5">
          <div class="form-check mb-2">
            <%= f.radio_button :payment_method, "credit_card", class: "form-check-input" %>
            <%= f.label :payment_method_credit_card, "クレジットカード", class: "form-check-label" %>
          </div>

          <div class="form-check">
            <%= f.radio_button :payment_method, "bank_transfer", class: "form-check-input" %>
            <%= f.label :payment_method_bank_transfer, "銀行振込", class: "form-check-label" %>
          </div>
        </div>

        <!-- お届け先 -->
        <h4 class="fw-bold mb-3">お届け先</h4>

        <div class="ms-4">
          <!-- 自分の住所 -->
          <div class="form-check mb-4">
            <%= f.radio_button :address_option, "0", checked: true, class: "form-check-input" %>
            <%= f.label :address_option_0, "ご自身の住所", class: "form-check-label fw-semibold" %>
            <div class="ms-4">
              〒<%= current_customer.postal_code %>
              <%= current_customer.address %><br>
              <%= current_customer.last_name + current_customer.first_name %>
            </div>
          </div>

          <!-- 登録済み住所 -->
          <div class="form-check mb-4">
            <%= f.radio_button :address_option, "1", class: "form-check-input" %>
            <%= f.label :address_option_1, "登録済住所から選択", class: "form-check-label fw-semibold" %>

            <div class="ms-4 mt-2">
              <%= f.collection_select :address_id,
                                      current_customer.addresses,
                                      :id,
                                      :address,
                                      {},
                                      { class: "form-select w-75" } %>
            </div>
          </div>

          <!-- 新しい住所 -->
          <div class="form-check mb-4">
            <%= f.radio_button :address_option, "2", class: "form-check-input" %>
            <%= f.label :address_option_2, "新しいお届け先", class: "form-check-label fw-semibold" %>

            <div class="ms-4 mt-3">
              <div class="row mb-3 align-items-center">
                <div class="col-md-3">
                  <%= f.label :postal_code, "郵便番号(ハイフンなし)", class: "form-label mb-0" %>
                </div>
                <div class="col-md-4">
                  <%= f.text_field :postal_code, class: "form-control", placeholder: "0000000" %>
                </div>
              </div>

              <div class="row mb-3 align-items-center">
                <div class="col-md-3">
                  <%= f.label :address, "住所", class: "form-label mb-0" %>
                </div>
                <div class="col-md-7">
                  <%= f.text_field :address, class: "form-control", placeholder: "東京都渋谷区代々木神園町0-0" %>
                </div>
              </div>

              <div class="row mb-4 align-items-center">
                <div class="col-md-3">
                  <%= f.label :name, "宛名", class: "form-label mb-0" %>
                </div>
                <div class="col-md-4">
                  <%= f.text_field :name, class: "form-control", placeholder: "令和道子" %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center mt-4">
          <%= f.submit "確認画面へ進む", class: "btn btn-primary px-4" %>
        </div>

      <% end %>
    </div>
  </div>
</div>