<h2>注文情報確認</h2>

<table class="table">
  <thead>
    <tr>
      <th>商品名</th>
      <th>単価（税込）</th>
      <th>数量</th>
      <th>小計</th>
    </tr>
  </thead>

  <tbody>
    <% @cart_items.each do |cart_item| %>
      <tr>
        <td><%= cart_item.item.name %></td>
        <td><%= cart_item.item.with_tax_price %></td>
        <td><%= cart_item.amount %></td>
        <td><%= cart_item.item.with_tax_price * cart_item.amount %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="mt-4">

  <table class="table table-bordered" style="width: 300px; margin-left: auto;">
    <tbody>

      <tr>
        <th>送料</th>
        <td>800</td>
      </tr>

      <tr>
        <th>請求金額</th>
        <td><%= @total + 800 %></td>
      </tr>
      <tr>
        <th>請求金額</th>
        <td><%= @total + 800 %></td>
      </tr>
    </tbody>
  </table>

</div>

<h4>支払い方法</h4>
<p><%= @order.payment_method_i18n %></p>

<h4>お届け先</h4>
<p>
  〒<%= @order.postal_code %><br>
  <%= @order.address %><br>
  <%= @order.name %>
</p>

<!-- hiddenでcreateへ送る -->
<%= form_with model: @order, url: orders_path, method: :post do |f| %>

  <%= f.hidden_field :payment_method %>
  <%= f.hidden_field :postal_code %>
  <%= f.hidden_field :address %>
  <%= f.hidden_field :name %>

  <%= f.submit "注文を確定する", class: "btn btn-success" %>

<% end %>

<%= link_to "戻る", new_orders_path, class: "btn btn-secondary" %>