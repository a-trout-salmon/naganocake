<h2>注文履歴詳細</h2>

<h4>注文情報</h4>

<table class="ttable table-bordered">
  <tbody>
    <tr>
      <th>注文日</th>
      <td><%= @order.created_at.strftime('%Y/%m/%d') %></td>
    </tr>

    <tr>
      <th>配送先</th>
      <td>
        〒<%= @order.postal_code %><br>
        <%= @order.address %><br>
        <%= @order.name %>
      </td>
    </tr>

    <tr>
      <th>支払方法</th>
      <td><%= @order.payment_method_label %></td>
    </tr>

    <tr>
      <th>注文ステータス</th>
      <td><%= @order.status_label %></td>
    </tr>
  </tbody>
</table>

<h4>請求情報</h4>

<table class="table table-bordered">
  <tbody>
    <tr>
      <th>商品合計</th>
      <td><%= @order.total_payment - @order.shipping_cost %></td>
    </tr>

    <tr>
      <th>配送料</th>
      <td><%= @order.shipping_cost %></td>
    </tr>

    <tr>
      <th><strong>ご請求額</strong></th>
      <td><%= @order.total_payment %></td>
    </tr>
  </tbody>
</table>

<h4>注文内容</h4>

<table class="table table-bordered">
  <thead>
    <tr>
      <th>商品名</th>
      <th>単価（税込）</th>
      <th>数量</th>
      <th>小計</th>
    </tr>
  </thead>

  <tbody>
    <% @order_details.each do |detail| %>
      <tr>
        <td><%= detail.item.name %></td>
        <td><%= detail.price %></td>
        <td><%= detail.amount %></td>
        <td><%= detail.price * detail.amount %></td>
      </tr>
    <% end %>
  </tbody>
</table>
