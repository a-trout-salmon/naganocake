<div class="container py-4 order-show-page">

  <div class="mb-4">
    <h2 class="d-inline-block px-4 py-1 bg-light fs-4 fw-bold">注文履歴詳細</h2>
  </div>

  <div class="row mb-4">
    <div class="col-md-7">
      <h4 class="fw-bold mb-2">注文情報</h4>

      <table class="table table-bordered align-middle order-info-table">
        <tbody>
          <tr>
            <th style="width: 22%;">注文日</th>
            <td><%= @order.created_at.strftime('%Y/%m/%d') %></td>
          </tr>

          <tr>
            <th>配送先</th>
            <td>
              〒<%= @order.postal_code %><br>
              <%= @order.address %><br>
              <%= @order.name %>
            </td>
          </tr>

          <tr>
            <th>支払方法</th>
            <td><%= @order.payment_method_label %></td>
          </tr>

          <tr>
            <th>ステータス</th>
            <td><%= @order.status_label %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="col-md-4 offset-md-1">
      <h4 class="fw-bold mb-2">請求情報</h4>

      <table class="table table-bordered align-middle billing-table">
        <tbody>
          <tr>
            <th style="width: 55%;">商品合計</th>
            <td><%= number_with_delimiter(@order.total_payment - @order.shipping_cost) %></td>
          </tr>

          <tr>
            <th>配送料</th>
            <td><%= number_with_delimiter(@order.shipping_cost) %></td>
          </tr>

          <tr>
            <th>ご請求額</th>
            <td><%= number_with_delimiter(@order.total_payment) %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <h4 class="fw-bold mb-2">注文内容</h4>

    <table class="table table-bordered align-middle order-detail-table">
      <thead>
        <tr>
          <th style="width: 45%;">商品</th>
          <th style="width: 15%;">単価（税込）</th>
          <th style="width: 10%;">個数</th>
          <th style="width: 15%;">小計</th>
        </tr>
      </thead>

      <tbody>
        <% @order_details.each do |detail| %>
          <tr>
            <td><%= detail.item.name %></td>
            <td><%= number_with_delimiter(detail.price) %></td>
            <td><%= detail.amount %></td>
            <td><%= number_with_delimiter(detail.price * detail.amount) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

</div>