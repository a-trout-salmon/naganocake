<div class="registration-page py-4">
  <div class="container form-container">

    <h4 class="section-title mb-4">ログイン</h4>

    <p class="mb-4">会員の方はこちらからログイン</p>

    <%= form_with url: customer_session_path, local: true do |f| %>

      <div class="row form-row">
        <div class="col-md-3 form-label-col">メールアドレス</div>
        <div class="col-md-6">
          <%= f.email_field :email_address, class: "form-control", placeholder: "sample@example.com" %>
        </div>
      </div>

      <div class="row form-row">
        <div class="col-md-3 form-label-col">パスワード</div>
        <div class="col-md-6">
          <%= f.password_field :password, class: "form-control" %>
        </div>
      </div>

      <div class="text-center mt-4">
        <%= f.submit "ログイン", class: "btn btn-primary submit-btn" %>
      </div>

    <% end %>

    <div class="mt-5">
      <h5 class="section-title">会員登録がまだの方</h5>
      <p class="mt-3">
        <%= link_to "こちら", new_customer_registration_path %> から新規登録を行ってください。
      </p>
    </div>

  </div>
</div>
