<div class="container-fluid py-4 px-5">
  <div class="row">
    <div class="col-xl-10">

      <!-- タイトル -->
      <div class="mb-4">
        <h4 class="d-inline-block bg-light px-4 py-2 fw-bold mb-0">ログイン</h4>
      </div>

      <!-- ログイン案内 -->
      <div class="mb-4">
        <h5 class="d-inline-block bg-light px-4 py-2 fw-bold mb-0">会員の方はこちらからログイン</h5>
      </div>

      <%= form_with url: customer_session_path, local: true do |f| %>

        <!-- メールアドレス -->
        <div class="row align-items-center mb-3">
          <div class="col-lg-3 fw-bold text-nowrap">メールアドレス</div>
          <div class="col-lg-8">
            <%= f.email_field :email_address,
                  value: @email_address,
                  class: "form-control",
                  placeholder: "sample@example.com" %>
          </div>
        </div>

        <!-- パスワード -->
        <div class="row align-items-center mb-4">
          <div class="col-lg-3 fw-bold text-nowrap">パスワード</div>
          <div class="col-lg-8">
            <%= f.password_field :password, class: "form-control" %>
          </div>
        </div>

        <!-- ボタン -->
        <div class="row mb-5">
          <div class="col-lg-3"></div>
          <div class="col-lg-8 text-center">
            <%= f.submit "ログイン", class: "btn btn-primary px-5 py-2 fw-bold" %>
          </div>
        </div>

      <% end %>

      <!-- 新規登録誘導 -->
      <div class="mt-4">
        <h5 class="d-inline-block bg-light px-4 py-2 fw-bold mb-2">会員登録がお済みでない方</h5>
        <p class="ms-4 mb-0">
          <%= link_to "こちら", new_customer_registration_path %> から新規登録を行ってください。
        </p>
      </div>

    </div>
  </div>
</div>
