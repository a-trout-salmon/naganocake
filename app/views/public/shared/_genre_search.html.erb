<div class="border bg-white" style="max-width: 240px;">
  <div class="border-bottom text-center fw-bold py-2">
    ジャンル検索
  </div>

   <ul class="list-unstyled mb-0">
  <% @genres.each do |genre| %>
    <li class="border-bottom">
      <%= link_to genre.name,
            items_path(genre_id: genre.id),
            class: "d-block py-2 px-3 text-decoration-none #{'bg-light fw-bold' if params[:genre_id].to_i == genre.id}" %>
    </li>
  <% end %>
   </ul>
</div>