    </div>
  </div>

  <div class="row">
    <div class="col-lg-6 mx-auto text-center">
      <div
        class="about-hero rounded overflow-hidden"
        style="background-image: url('<%= asset_path("top_cake.png") %>');"
      ></div>
    </div>
  </div>

</div>
