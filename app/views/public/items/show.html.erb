<div class="container py-5">
  <div class="row">
    <div class="col-12 col-lg-3 mb-4 mb-lg-0">
      <%= render "public/shared/genre_search" %>
    </div>

    <div class="col-12 col-lg-9">
      <div class="row align-items-start">
        <div class="col-md-5 mb-4">
          <div
            class="border bg-white d-flex align-items-center justify-content-center"
            style="width: 100%; aspect-ratio: 4 / 3; overflow: hidden;"
          >
            <% if @item.image.attached? %>
              <%= image_tag @item.image, class: "img-fluid w-100 h-100", style: "object-fit: cover;" %>
            <% else %>
              <span>画像なし</span>
            <% end %>
          </div>
        </div>

        <div class="col-md-7">
          <h2 class="fw-bold mb-4"><%= @item.name %></h2>

          <p class="fs-5 mb-5"><%= @item.introduction %></p>

          <p class="fw-bold mb-5" style="font-size: 2rem;">
            ¥<%= @item.with_tax_price.to_fs(:delimited) %>
            <span style="font-size: 1rem;">(税込)</span>
          </p>

          <%= form_with model: @cart_item, url: cart_items_path, local: true do |f| %>
            <%= f.hidden_field :item_id, value: @item.id %>

            <div class="d-flex align-items-center gap-3 flex-wrap">
              <%= f.select :amount,
                  options_for_select((1..10).to_a, 1),
                  {},
                  class: "form-select",
                  style: "width: 180px; min-width: 180px;" %>

              <%= f.submit "カートに入れる", class: "btn btn-success px-4 py-2 fw-bold" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>