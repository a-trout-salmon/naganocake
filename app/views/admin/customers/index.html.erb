<div class="container py-5">

  <!-- ヘッダー -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold px-4 py-2 mb-0" style="background:#f2f2f2;">
      会員一覧
    </h2>
  </div>

  <!-- テーブル -->
  <table class="table table-hover align-middle">

    <thead class="table-light">
      <tr>
        <th>会員ID</th>
        <th>氏名</th>
        <th>メールアドレス</th>
        <th>ステータス</th>
      </tr>
    </thead>

    <tbody>
      <% @customers.each do |customer| %>
        <tr>

          <td class="text-muted"><%= customer.id %></td>

          <td>
            <%= link_to customer.full_name,
                admin_customer_path(customer),
                class: "text-decoration-underline text-dark" %>
          </td>

          <td><%= customer.email_address %></td>

          <td>
            <% if customer.is_active %>
              <span class="text-success fw-bold">有効</span>
            <% else %>
              <span class="text-muted fw-bold">退会</span>
            <% end %>
          </td>

        </tr>
      <% end %>
    </tbody>

  </table>

</div>