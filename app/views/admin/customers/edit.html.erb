<div class="container py-5">
  <div class="row">
    <div class="col-md-10 mx-auto">

      <h4 class="mb-4">
        <span class="bg-light px-3"><%= @customer.full_name %>さんの会員情報編集</span>
      </h4>

      <%= form_with model: [:admin, @customer], local: true do |f| %>
        <table class="table table-borderless align-middle">
          <tbody>
            <tr>
              <th style="width: 180px;">会員ID</th>
              <td><%= @customer.id %></td>
            </tr>

            <tr>
              <th>氏名</th>
              <td>
                <%= f.text_field :last_name %>
                <%= f.text_field :first_name %>
              </td>
            </tr>

            <tr>
              <th>フリガナ</th>
              <td>
                <%= f.text_field :last_name_kana %>
                <%= f.text_field :first_name_kana %>
              </td>
            </tr>

            <tr>
              <th>郵便番号</th>
              <td><%= f.text_field :postal_code %></td>
            </tr>

            <tr>
              <th>住所</th>
              <td><%= f.text_field :address, size: 60 %></td>
            </tr>

            <tr>
              <th>電話番号</th>
              <td><%= f.text_field :telephone_number %></td>
            </tr>

            <tr>
              <th>メールアドレス</th>
              <td><%= f.email_field :email_address %></td>
            </tr>

            <tr>
              <th>会員ステータス</th>
              <td>
                <%= f.radio_button :is_active, true %>
                <%= f.label :is_active_true, "有効" %>

                <%= f.radio_button :is_active, false %>
                <%= f.label :is_active_false, "退会" %>
              </td>
            </tr>
          </tbody>
        </table>

        <div class="mt-4">
          <%= f.submit "変更を保存" %>
        </div>
      <% end %>

    </div>
  </div>
</div>