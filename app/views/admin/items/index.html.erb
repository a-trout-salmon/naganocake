<div class="container py-5">
  <h2 class="fw-bold d-inline-block px-4 py-1 mb-4" style="background:#f2f2f2;">
    商品一覧
  </h2>

  <div class="text-end mb-3">
    <%= link_to "+", new_admin_item_path, class: "btn btn-outline-secondary rounded-circle" %>
  </div>

  <table class="table align-middle">
    <thead style="background:#f2f2f2;">
      <tr>
        <th>商品ID</th>
        <th>商品名</th>
        <th>税抜価格</th>
        <th>ジャンル</th>
        <th>ステータス</th>
      </tr>
    </thead>

    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td><%= item.id %></td>

          <td>
            <%= link_to item.name, admin_item_path(item) %>
          </td>

          <td><%= item.price.to_fs(:delimited) %></td>

          <td><%= item.genre.name %></td>

          <td>
            <% if item.is_active %>
              <span class="text-success fw-bold">販売中</span>
            <% else %>
              <span class="text-secondary">販売停止中</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>