<div class="container py-5">

  <!-- タイトル -->
  <div class="mb-4">
    <h2 class="fw-bold px-4 py-2 d-inline-block" style="background:#f2f2f2;">
      商品詳細
    </h2>
  </div>

  <div class="row">

    <!-- 左：画像 -->
    <div class="col-md-4">
      <% if @item.image.attached? %>
        <%= image_tag @item.image, class: "img-fluid rounded" %>
      <% else %>
        <%= image_tag "no_image.jpg", class: "img-fluid rounded" %>
      <% end %>
    </div>

    <!-- 右：情報 -->
    <div class="col-md-6">

      <div class="mb-3 d-flex">
        <strong style="min-width: 120px;">商品名</strong>
        <div><%= @item.name %></div>
      </div>

      <div class="mb-3 d-flex">
        <strong style="min-width: 120px;">商品説明</strong>
        <div><%= @item.introduction %></div>
      </div>

      <div class="mb-3 d-flex">
        <strong style="min-width: 120px;">ジャンル</strong>
        <div><%= @item.genre.name %></div>
      </div>

      <div class="mb-3 d-flex">
        <strong style="min-width: 120px;">税込価格</strong>
        <div>¥<%= @item.with_tax_price.to_fs(:delimited) %></div>
      </div>

      <div class="mb-3 d-flex">
        <strong style="min-width: 120px;">販売ステータス</strong>
        <div>
          <% if @item.is_active %>
            <span class="text-success fw-bold">販売中</span>
          <% else %>
            <span class="text-muted fw-bold">販売停止中</span>
          <% end %>
        </div>
      </div>

      <div class="mt-4">
        <%= link_to "編集する", edit_admin_item_path(@item),
            class: "btn btn-success px-4" %>
      </div>

    </div>

  </div>
</div>