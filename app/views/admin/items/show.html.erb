<div class="container py-5">
  <h2 class="fw-bold d-inline-block px-4 py-1 mb-5" style="background:#f2f2f2;">
    商品詳細
  </h2>

  <div class="row">
    <div class="col-md-4">
      <% if @item.image.attached? %>
        <%= image_tag @item.image, class: "img-fluid" %>
      <% end %>
    </div>

    <div class="col-md-6">
      <p>商品名：<%= @item.name %></p>
      <p>商品説明：<%= @item.introduction %></p>
      <p>ジャンル：<%= @item.genre.name %></p>
      <p>税込価格：<%= (@item.price * 1.1).floor %>円</p>

      <p>
        販売ステータス：
        <% if @item.is_active %>
          <span class="text-success fw-bold">販売中</span>
        <% else %>
          <span class="text-secondary">販売停止中</span>
        <% end %>
      </p>

      <div class="mt-4">
        <%= link_to "編集する", edit_admin_item_path(@item),
            class: "btn btn-success px-4" %>
      </div>
    </div>
  </div>
</div>