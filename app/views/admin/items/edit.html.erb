<div class="container py-5">
  <h2 class="fw-bold d-inline-block px-4 py-1 mb-5" style="background:#f2f2f2;">
    商品編集
  </h2>

  <%= form_with model: [:admin, @item], local: true do |f| %>

    <div class="row mb-4 align-items-center">
      <div class="col-md-2">商品画像</div>
      <div class="col-md-4">
        <%= f.file_field :image %>
      </div>
    </div>

    <div class="row mb-4">
      <div class="col-md-2">商品名</div>
      <div class="col-md-4">
        <%= f.text_field :name, class: "form-control" %>
      </div>
    </div>

    <div class="row mb-4">
      <div class="col-md-2">商品説明</div>
      <div class="col-md-4">
        <%= f.text_area :introduction, class: "form-control" %>
      </div>
    </div>

    <div class="row mb-4">
      <div class="col-md-2">ジャンル</div>
      <div class="col-md-4">
        <%= f.collection_select :genre_id, Genre.all, :id, :name, {}, class: "form-select" %>
      </div>
    </div>

    <div class="row mb-4">
      <div class="col-md-2">税抜価格</div>
      <div class="col-md-4 d-flex">
        <%= f.number_field :price, class: "form-control me-2" %> 円
      </div>
    </div>

    <div class="row mb-5">
      <div class="col-md-2">販売ステータス</div>
      <div class="col-md-4">
        <%= f.radio_button :is_active, true %> 販売中
        <%= f.radio_button :is_active, false %> 販売停止中
      </div>
    </div>

    <div class="text-center">
      <%= f.submit "変更を保存", class: "btn btn-success px-5 py-2 fw-bold" %>
    </div>

  <% end %>
</div>