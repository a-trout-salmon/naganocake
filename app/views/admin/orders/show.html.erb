<div class="container py-5">

  <!-- タイトル -->
  <div class="mb-4">
    <h2 class="fw-bold px-4 py-2 d-inline-block" style="background:#f2f2f2;">
      注文履歴詳細
    </h2>
  </div>

  <!-- 基本情報 -->
  <div style="max-width: 700px;">

    <div class="mb-3 d-flex">
      <strong style="min-width: 150px;">購入者</strong>
      <div>
        <%= link_to @order.customer.last_name + @order.customer.first_name,
            admin_customer_path(@order.customer),
            class: "text-decoration-underline text-dark" %>
      </div>
    </div>

    <div class="mb-3 d-flex">
      <strong style="min-width: 150px;">注文日</strong>
      <div><%= @order.created_at.strftime('%Y/%m/%d') %></div>
    </div>

    <div class="mb-3 d-flex align-items-start">
      <strong style="min-width: 150px;">配送先</strong>
      <div>
        〒<%= @order.postal_code %><br>
        <%= @order.address %><br>
        <%= @order.name %>
      </div>
    </div>

    <div class="mb-3 d-flex">
      <strong style="min-width: 150px;">支払方法</strong>
      <div><%= @order.payment_method_label %></div>
    </div>

    <div class="mb-4 d-flex align-items-center">
      <strong style="min-width: 150px;">注文ステータス</strong>

      <%= form_with model: @order,
            url: admin_order_path(@order),
            method: :patch,
            local: true do |f| %>

        <div class="d-flex align-items-center">

          <%= f.select :status,
            Order.statuses.keys.map { |k| [I18n.t("activerecord.attributes.order.statuses.#{k}"), k] },
            {},
            class: "form-select w-auto me-2" %>

          <%= f.submit "更新", class: "btn btn-success btn-sm" %>

        </div>

      <% end %>
    </div>

  </div>

  <!-- 商品一覧 -->
  <div class="row mt-4">

    <div class="col-md-8">
      <table class="table table-hover align-middle">

        <thead class="table-light">
          <tr>
            <th>商品名</th>
            <th>単価（税込）</th>
            <th>数量</th>
            <th>小計</th>
            <th>制作ステータス</th>
          </tr>
        </thead>

        <tbody>
          <% @order_details.each do |detail| %>
            <tr>

              <td><%= detail.item.name %></td>
              <td><%= detail.price.to_fs(:delimited) %></td>
              <td><%= detail.amount %></td>
              <td><%= (detail.price * detail.amount).to_fs(:delimited) %></td>

              <td>
                <%= form_with model: detail,
                      url: admin_order_detail_path(detail),
                      method: :patch,
                      local: true do |f| %>

                  <div class="d-flex align-items-center">

                    <%= f.select :making_status,
                      OrderDetail.making_statuses.keys.map { |k| [I18n.t("activerecord.attributes.order_detail.making_statuses.#{k}"), k] },
                      {},
                      class: "form-select w-auto me-2" %>

                    <%= f.submit "更新", class: "btn btn-success btn-sm" %>

                  </div>

                <% end %>
              </td>

            </tr>
          <% end %>
        </tbody>

      </table>
    </div>

    <!-- 金額 -->
    <div class="col-md-4">

      <div class="d-flex justify-content-between mb-2">
        <span><strong>商品合計</strong></span>
        <span><%= @order_details.sum { |d| d.price * d.amount }.to_fs(:delimited) %>円</span>
      </div>

      <div class="d-flex justify-content-between mb-2">
        <span><strong>送料</strong></span>
        <span><%= @order.shipping_cost.to_fs(:delimited) %>円</span>
      </div>

      <div class="d-flex justify-content-between mb-2">
        <strong>請求金額</strong>
        <strong><%= @order.total_payment.to_fs(:delimited) %>円</strong>
      </div>

    </div>

  </div>

</div>