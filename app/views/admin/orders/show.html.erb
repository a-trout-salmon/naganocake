<h4><span style="background-color: #f0f0f0; padding: 4px;">注文履歴詳細</span></h4>

<div class="mb-3 d-flex">
  <strong style="min-width: 120px;">購入者</strong>
  <div>
    <%= link_to @order.customer.last_name + @order.customer.first_name,
    admin_customer_path(@order.customer) %>
  </div>
</div>

<div class="mb-3 d-flex">
  <strong style="min-width: 120px;">注文日</strong>
  <%= @order.created_at.strftime('%Y/%m/%d') %>
</div>


<div class="mb-3 d-flex align-items-start">

  <!-- ラベル -->
  <strong style="min-width: 120px;">配送先</strong>

  <!-- 郵便番号 + 名前 -->
  <div>
    <div>〒<%= @order.postal_code %></div>
    <div class="mt-1"><%= @order.name %></div>
  </div>

  <!-- 住所 -->
  <div>
    <%= @order.address %>
  </div>
</div>

<div class="mb-3 d-flex">
  <strong style="min-width: 120px;">支払方法</strong>
  <%= @order.payment_method_label %>
</div>

<div class="mb-3">
  <strong>注文ステータス</strong>
    <%= form_with model: @order,
                  url: admin_order_path(@order),
                  method: :patch,
                  local: true do |f| %>

      <div class="d-flex align-items-center">

          <!-- ドロップダウン -->
        <%= f.select :status,
          Order.statuses.keys.map { |k| [I18n.t("activerecord.attributes.order.statuses.#{k}"), k] },
          {},
          class: "form-select w-auto me-2" %>

          <!-- 更新ボタン -->
          <%= f.submit "更新", class: "btn btn-success btn-sm" %>

      </div>

    <% end %>
</div>

<div class="row mt-4">
  <div class="col-md-8">
    <table class="table table-bordered">
      <thead class="table-light">
        <tr>
          <th>商品名</th>
          <th>単価（税込）</th>
          <th>数量</th>
          <th>小計</th>
          <th>制作ステータス</th>
        </tr>
      </thead>

      <tbody>
        <% @order_details.each do |detail| %>
          <tr>
            <!-- 商品名 -->
            <td><%= detail.item.name %></td>

            <!-- 単価 -->
            <td><%= detail.price %></td>

            <!-- 数量 -->
            <td><%= detail.amount %></td>

            <!-- 小計 -->
            <td><%= detail.price * detail.amount %></td>

            <!-- 制作ステータス -->
            <td>
              <%= form_with model: detail,
                            url: admin_order_detail_path(detail),
                            method: :patch,
                            local: true do |f| %>

                <div class="d-flex align-items-center">

                  <!-- ドロップダウン -->
                  <%= f.select :making_status,
                    OrderDetail.making_statuses.keys.map { |k| [I18n.t("activerecord.attributes.order_detail.making_statuses.#{k}"), k] },
                    {},
                    class: "form-select w-auto me-2" %>

                  <!-- 更新ボタン -->
                  <%= f.submit "更新", class: "btn btn-success btn-sm" %>

                </div>

              <% end %>
            </td>

          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

    <div class="col-md-4">

    <div class="d-flex justify-content-between mb-2">
    <span><strong>商品合計</strong></span>
      <span>
        <%= @order_details.sum { |d| d.price * d.amount } %>円
      </span>
    </div>

      <div class="d-flex justify-content-between mb-2">
        <span><strong>送料</strong></span>
        <span><%= @order.shipping_cost %>円</span>
      </div>

      <div class="d-flex justify-content-between mb-2">
        <strong>請求金額</strong>
        <strong>
          <%= @order.total_payment %>円
        </strong>
      </div>

    </div>

  </div>

</div>