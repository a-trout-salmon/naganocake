<div class="container py-5">

  <!-- タイトル -->
  <div class="mb-4">
    <h2 class="fw-bold px-4 py-2 d-inline-block" style="background:#f2f2f2;">
      ジャンル一覧・追加
    </h2>
  </div>

  <!-- 新規登録フォーム -->
  <div class="mb-5" style="max-width: 600px;">
    <%= form_with model: [:admin, @genre], local: true do |f| %>

      <div class="d-flex align-items-center gap-3">

        <label class="fw-bold mb-0" style="min-width: 100px;">
          ジャンル名
        </label>

        <%= f.text_field :name,
            placeholder: "ジャンル名",
            class: "form-control" %>

        <%= f.submit "新規登録",
            class: "btn btn-success fw-bold px-4" %>

      </div>

    <% end %>
  </div>

  <!-- 一覧テーブル -->
  <div style="max-width: 600px;">
    <table class="table table-hover align-middle">

      <thead class="table-light">
        <tr>
          <th>ジャンル</th>
          <th class="text-end"></th>
        </tr>
      </thead>

      <tbody>
        <% @genres.each do |genre| %>
          <tr>

            <td><%= genre.name %></td>

            <td class="text-end">
              <%= link_to "編集する",
                  edit_admin_genre_path(genre),
                  class: "btn btn-success px-4" %>
            </td>

          </tr>
        <% end %>
      </tbody>

    </table>
  </div>

</div>